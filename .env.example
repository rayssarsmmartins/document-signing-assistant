# Copie para .env (gitignored). `bin/cs doctor` confere tudo.

# --- Clicksign ---------------------------------------------------------------
# Conta usada pelo agente. A sessão OAuth enxerga várias contas; o agente chama
# clicksign_select_account com esta chave no início de toda jornada.
CLICKSIGN_ACCOUNT_KEY=
CLICKSIGN_ACCOUNT_NAME=
# Envia a ordem de assinatura (campo group) ao MCP. Só ligue depois do spike F0
# confirmar que a tool aceita o campo.
CLICKSIGN_SEND_GROUP=false
# Formas de confirmação de identidade oferecidas no MVP.
CS_ALLOWED_AUTHS=email,sms,whatsapp

# --- Ponte de upload -----------------------------------------------------------
# O MCP só aceita URL HTTPS pública.
#   tunnel (padrão): serve o arquivo desta máquina por um quick tunnel do Cloudflare
#                    (https://<aleatório>.trycloudflare.com/<segredo>/arquivo.pdf), sem conta
#                    nem bucket; encerra no TTL, após UPLOAD_MAX_DOWNLOADS ou após o envio.
#                    Requer o binário `cloudflared` (CLOUDFLARED_BIN para caminho explícito).
#   s3 | gcs:        bucket próprio com URL assinada (alternativa para produção).
UPLOAD_BACKEND=tunnel
UPLOAD_TTL_SECONDS=600
UPLOAD_MAX_DOWNLOADS=3
UPLOAD_BUCKET=
UPLOAD_PREFIX=envio-pontual/
# S3 ou compatível (Cloudflare R2, MinIO, Backblaze B2). Credenciais pelas
# variáveis padrão da AWS (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) ou ~/.aws.
S3_ENDPOINT_URL=
S3_REGION=
# GCS: GOOGLE_APPLICATION_CREDENTIALS apontando para uma service account
# (URL assinada exige service account) e `uv sync --extra gcs`.

# --- Execução ---------------------------------------------------------------
# true = monta tudo, mas NÃO sobe arquivo nem chama a tool de envio.
CS_DRY_RUN=false
# true = cria envelopes de verdade, mas a Clicksign NÃO notifica os signatários
# (communicate_events.signature_request=none). Só para testes com e-mails fictícios.
CS_SILENT_SEND=false
CS_RETENTION_DAYS=7
# Diretório onde a ponte pi↔Telegram salva anexos (apagados após o envio).
# CS_TELEGRAM_TMP=~/.pi/agent/tmp/telegram
